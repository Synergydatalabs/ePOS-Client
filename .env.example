# ============================================================================
# tap-app environment variables — PHASE 1 ADDITIONS
# ============================================================================
# Copy these into your .env (development) and .env.production (server) and
# replace placeholders with real values.
#
# DO NOT commit real values. .env / .env.production must stay in .gitignore.
# ============================================================================

# ----------------------------------------------------------------------------
# AWS S3 — for image uploads (menu, floor plan backgrounds, logos)
# ----------------------------------------------------------------------------
# IMPORTANT: bucket policy must block all public access.
# Files are served via presigned URLs only (security).
#
# IAM user must have minimum permissions:
#   s3:PutObject, s3:GetObject, s3:DeleteObject, s3:PutObjectAcl   on bucket/*
#   s3:ListBucket                                                  on bucket
# DO NOT grant s3:* or bucket-level write.
#
# Tenant isolation is enforced at the application + DB-trigger level:
# every s3_key MUST start with <tenant_uuid>/.
AWS_S3_BUCKET=oreugo-app-uploads
AWS_S3_REGION=ca-central-1
AWS_S3_ACCESS_KEY_ID=AKIA_PLACEHOLDER_REPLACE_ME
AWS_S3_SECRET_ACCESS_KEY=PLACEHOLDER_REPLACE_ME

# Optional — public URL prefix. If you set up CloudFront, point this there.
# Otherwise the app generates s3.amazonaws.com URLs automatically.
# AWS_S3_PUBLIC_URL=https://cdn.oreugo.ca
AWS_S3_PUBLIC_URL=

# Presigned upload URL expiration (seconds). Default 300 (5 min) is fine
# for browser uploads. Don't set above 3600 (1 hour).
AWS_S3_UPLOAD_URL_EXPIRES_SECONDS=300

# Maximum file size for direct uploads (bytes). Default 10 MB.
# Set higher for floor plan backgrounds (architect drawings).
AWS_S3_MAX_UPLOAD_BYTES=10485760

# ----------------------------------------------------------------------------
# SMS — for reservation confirmations and waitlist notifications (Phase 5b)
# ----------------------------------------------------------------------------
# SMS is OPTIONAL. If TWILIO_* credentials are missing, app runs in DEV mode
# and logs SMS to server console instead of sending. To disable entirely,
# set SMS_ENABLED=false.
#
# Twilio setup:
#   1. https://twilio.com -> sign up
#   2. Buy a phone number with SMS capability ($1/mo + per-message fees)
#   3. Get Account SID + Auth Token from the dashboard
#   4. Paste below + restart pm2

# Master kill switch. Set to "false" to completely disable SMS sending.
SMS_ENABLED=true

# When Twilio creds missing, fall back to dev mode (log to console).
# Set to "false" if you'd rather throw an error than silently log.
SMS_DEV_FALLBACK=true

# Twilio credentials (leave blank to stay in dev mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=    # E.164 format, e.g. +14165551234

# Optional — override the URL used when verifying Twilio webhook signatures.
# Defaults to https://<request-host>/api/webhooks/twilio-sms (auto-derived).
# Set explicitly if you're behind a proxy that rewrites the host.
TWILIO_WEBHOOK_URL=

# ----------------------------------------------------------------------------
# WhatsApp Business via Meta Cloud API (Phase 5c)
# ----------------------------------------------------------------------------
# OPTIONAL. If META_WHATSAPP_* missing, runs in dev mode (console log).
# Set WHATSAPP_ENABLED=false to disable entirely.
#
# Setup:
#   1. business.facebook.com → create Business Account
#   2. Add WhatsApp Business → add a phone number → verify
#   3. Settings → Users → System Users → create one → assign "Admin" role on
#      the WhatsApp Business Account → Generate Token (never expires)
#   4. WhatsApp Business → API Setup → copy Phone Number ID + paste token
#   5. Set the webhook URL in Meta:
#        https://itap.zashx.com/api/webhooks/whatsapp
#      Verify token: any random string (paste it here as WEBHOOK_VERIFY_TOKEN)
#   6. Pre-approve message templates (Phase 5d sends transactional templates)
#
# MULTI-TENANT: these env vars are the SHARED account used for default
# tenants. To let a specific tenant use their own Meta account, store their
# credentials in the DB (TenantSettings.whatsappCredentials — coming Phase 5d).

WHATSAPP_ENABLED=true
WHATSAPP_DEV_FALLBACK=true

# From Meta API Setup page
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# Webhook verification — Meta calls our endpoint to confirm we own it.
# Make up any random string, paste it in Meta's webhook config + here.
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Used to verify Meta's HMAC signature on inbound webhook calls.
# Find under Meta App → Settings → Basic → App Secret.
META_WHATSAPP_APP_SECRET=
